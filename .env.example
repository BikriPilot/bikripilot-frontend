# Frontend template: copy to frontend/.env.local for development.
# Production: set these in Vercel/your frontend host BEFORE building.
# NEXT_PUBLIC_* values are visible to every browser. NEVER put secrets or DB credentials here.
# Public values are embedded at build time; rebuild/redeploy after changing them.

# Development: backend REST base, including /api/v1.
# Production example: https://api.bikrio.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Socket base origin, without /api/v1. Production example: https://api.bikrio.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Match the actual frontend port and backend WEB_URL/CORS_ORIGINS.
# Production example: https://bikrio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public Cloudflare site key only; its matching SECRET belongs in backend TURNSTILE_SECRET_KEY.
# Development: test site key or blank while bot checks are off.
# Production: real site key allowing your deployed hostname; enable in Admin > Security.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Next sets NODE_ENV for dev/build/start; do not force production in a local next dev session.
# Subscription pricing/benefits/provider availability come from backend Admin settings.
# For a preview deployment, use an approved staging API and add that exact origin to backend CORS.
